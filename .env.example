# Copy to .env and fill in. Never commit .env, never paste these values in chat.
# Razorpay TEST keys only (must start with rzp_test_) -- https://dashboard.razorpay.com (Test Mode > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: switches purchases from dry_run to Razorpay test-mode orders
PAYMENT_MODE=dry_run
# LLM for the behaviour experiment (policy=llm). Either one; Groq wins if both are set.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_POLICY_MODEL=openai/gpt-oss-20b
# ASSISTANT_MODEL=openai/gpt-oss-20b
# ASSISTANT_SEARCH_MODEL=groq/compound
# Optional but recommended: reliable web search for the shopping assistant (free key at tavily.com).
# TAVILY_API_KEY=
# SEARCH_BACKEND=auto   # auto | tavily | compound | ddg
